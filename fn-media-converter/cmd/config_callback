#!/bin/bash

### This script is called after the user change environment variables in application setting page.
echo "=== 服务重启 ==="
echo "开始时间: $(date '+%Y-%m-%d %H:%M:%S')"

# 使用与原脚本相同的环境变量
# 这些变量应该已经在环境中设置，如果没有，您需要取消下面的注释并设置正确的值
# TRIM_PKGVAR="/path/to/your/var"  # 如果未设置，请取消注释并设置正确路径
# TRIM_APPDEST="/path/to/your/app"  # 如果未设置，请取消注释并设置正确路径

# 检查必要的环境变量
if [[ -z "${TRIM_PKGVAR}" || -z "${TRIM_APPDEST}" ]]; then
    echo "错误: 缺少必要的环境变量"
    echo "请设置 TRIM_PKGVAR 和 TRIM_APPDEST 环境变量"
    exit 1
fi

# 定义与原脚本相同的变量
LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export LC_CTYPE=en_US.UTF-8
export JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8"
export _JAVA_OPTIONS="-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8"

CMD="java \
    -Dfile.encoding=UTF-8 \
    -Dsun.jnu.encoding=UTF-8 \
    -Dclient.encoding.override=UTF-8 \
    -Dserver.encoding.override=UTF-8 \
    -Dconsole.encoding=UTF-8 \
    -Duser.language=zh \
    -Duser.country=CN \
    -Duser.region=CN \
    -Duser.variant= \
    -jar ${TRIM_APPDEST}/server/media-converter-1.0.0.jar \
    --spring.profiles.active=fn \
    --server.tomcat.uri-encoding=UTF-8 \
    --spring.messages.encoding=UTF-8 \
    --spring.http.encoding.charset=UTF-8 \
    --spring.http.encoding.enabled=true \
    --spring.http.encoding.force=true"

# 日志函数
log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# 检查进程函数
check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0  # 进程存在
    else
        return 1  # 进程不存在
    fi
}

# 停止服务
echo "1. 正在停止服务..."

if [ -f "${PID_FILE}" ]; then
    pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    echo "   找到进程ID: ${pid}"

    if check_process "${pid}"; then
        echo "   发送TERM信号..."
        log_msg "重启脚本: 发送TERM信号到PID:${pid}"
        kill -TERM "${pid}"

        # 等待进程退出
        count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            echo "   等待进程停止... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            echo "   发送KILL信号..."
            log_msg "重启脚本: 发送KILL信号到PID:${pid}"
            kill -KILL "${pid}"
            sleep 1
        fi
    else
        echo "   进程不存在，清理PID文件"
    fi

    # 清理PID文件
    rm -f "${PID_FILE}"
    echo "   清理PID文件完成"
else
    echo "   未找到PID文件，服务可能未运行"
fi

# 等待确保端口释放
sleep 3

# 启动服务
echo ""
echo "2. 正在启动服务..."

# 设置Java环境
export PATH=/var/apps/java-17-openjdk/target/bin:$PATH
echo "   Java版本:"
java --version 2>&1 | head -3

# 记录启动日志
log_msg "重启脚本: 开始启动服务"
log_msg "重启脚本: 工作目录: $(pwd)"
log_msg "重启脚本: 使用Java路径: $(which java)"

# 启动服务
echo "   启动命令: ${CMD}"
bash -c "${CMD}" >> "${LOG_FILE}" 2>&1 &
NEW_PID=$!

# 保存PID
echo "${NEW_PID}" > "${PID_FILE}"
echo "   新进程ID: ${NEW_PID}"
log_msg "重启脚本: 服务启动，PID=${NEW_PID}"

# 验证启动是否成功
echo ""
echo "3. 验证服务状态..."

sleep 2  # 给服务一些启动时间

if [ -f "${PID_FILE}" ]; then
    pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

    if check_process "${pid}"; then
        echo "   ✓ 服务启动成功!"
        echo "   PID: ${pid}"
        echo "   日志文件: ${LOG_FILE}"
        log_msg "重启脚本: 服务启动成功，PID=${pid}"
    else
        echo "   ✗ 服务启动失败!"
        echo "   请检查日志文件: ${LOG_FILE}"
        log_msg "重启脚本: 服务启动失败"
        rm -f "${PID_FILE}"
        exit 1
    fi
else
    echo "   ✗ PID文件未创建，服务启动失败!"
    log_msg "重启脚本: 服务启动失败，未创建PID文件"
    exit 1
fi

echo ""
echo "=== 重启完成 ==="
echo "完成时间: $(date '+%Y-%m-%d %H:%M:%S')"
echo "PID文件: ${PID_FILE}"
echo "日志文件: ${LOG_FILE}"
echo "================"